# base-api environment variables
#
# Copy this file to `api/.env` and fill in the values that apply to your
# environment. `api/.env` is git-ignored; this template is tracked so the
# team has a single source of truth for what variables exist.
#
# Format: `<VARIABLE>=<default-or-example-value>`.

# --------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------

# Port the API listens on inside the container. Matches `ports:` in compose.
PORT=5050

# Set to `1` in dev to wait for the postgres container before booting.
# Set to anything else (or leave empty) in prod, where the DB lives elsewhere.
WAIT_DB=1

# --------------------------------------------------------------------
# Flask
# --------------------------------------------------------------------

# Flask entrypoint. `wsgi.py` is the local entrypoint used by `flask run`.
# In production the entrypoint.prod.sh sets this to `app:create_app`.
FLASK_APP=wsgi.py

# `production` switches create_app() to ProdConfig (SQLALCHEMY_ECHO=False).
# Leave unset for DevConfig.
FLASK_CONFIG=

# Enables Werkzeug reloader + interactive debugger. **Never set in prod.**
# Defaults to unset. The dev Dockerfile does not hardcode this anymore.
FLASK_DEBUG=

# --------------------------------------------------------------------
# Database
# --------------------------------------------------------------------

# Full SQLAlchemy connection URI. Overrides the hardcoded fallback in
# DevConfig / ProdConfig. Required in production.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
SQLALCHEMY_DATABASE_URI=postgresql://postgres:pgpassword@postgres:5432/principal

# --------------------------------------------------------------------
# Gunicorn (production only)
# --------------------------------------------------------------------

# Number of sync workers. Default 2 in entrypoint.prod.sh.
GUNICORN_WORKERS=2

# Per-request timeout in seconds. Default 120.
GUNICORN_TIMEOUT=120
