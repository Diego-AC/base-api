# base-api environment variables
#
# Copy this file to `api/.env` and fill in the values that apply to your
# environment. `api/.env` is git-ignored; this template is tracked so the
# team has a single source of truth for what variables exist.
#
# Format: `<VARIABLE>=<default-or-example-value>`.

# --------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------

# Port the API listens on inside the container. Matches `ports:` in compose.
PORT=5050

# Set to `1` in dev to wait for the postgres container before booting.
# Set to anything else (or leave empty) in prod, where the DB lives elsewhere.
WAIT_DB=1

# --------------------------------------------------------------------
# Flask
# --------------------------------------------------------------------

# Flask entrypoint. `wsgi.py` is the local entrypoint used by `flask run`.
# In production the entrypoint.prod.sh sets this to `app:create_app`.
FLASK_APP=wsgi.py

# `production` switches create_app() to ProdConfig (SQLALCHEMY_ECHO=False).
# Leave unset for DevConfig.
FLASK_CONFIG=

# Enables Werkzeug reloader + interactive debugger. **Never set in prod.**
# Defaults to unset. The dev Dockerfile does not hardcode this anymore.
FLASK_DEBUG=

# --------------------------------------------------------------------
# Database
# --------------------------------------------------------------------

# Postgres database name. Used by the postgres image's POSTGRES_DB env var
# (so it creates the DB on first boot) and as the fallback in DevConfig.
# Rename this to match your service in any non-template deployment.
POSTGRES_DB=sample

# Full SQLAlchemy connection URI. Overrides the hardcoded fallback in
# DevConfig / ProdConfig. Required in production.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
SQLALCHEMY_DATABASE_URI=postgresql://postgres:pgpassword@postgres:5432/sample

# --------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------

# Used by login_required to verify HS256 JWT tokens. Required in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Secret used by HashBackend to validate the `Authorization: Hash <key>:<ts>:<sig>`
# header. Only required if your fork registers the 'hash' backend.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_SECRET=

# Validity window (in seconds) for a hash signature. The frontend computes the
# signature and sends it together with a timestamp; the backend rejects hashes
# older than this. Default: 10 seconds.
HASH_VALIDITY_SECONDS=10

# --------------------------------------------------------------------
# CORS
# --------------------------------------------------------------------

# Comma-separated list of allowed origins. Empty = CORS disabled.
# DevConfig defaults to common localhost ports; ProdConfig defaults to empty
# so each deployment sets its own allow-list.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --------------------------------------------------------------------
# Rate limiting
# --------------------------------------------------------------------

# Set to `true` to enable Flask-Limiter with the default below.
RATELIMIT_ENABLED=false

# Default per-IP limit when enabled. Format: "<N> per <period>".
RATELIMIT_DEFAULT=100 per minute

# Storage backend. `memory://` is single-process; use Redis in prod
# (`redis://host:6379`) when running multiple gunicorn workers.
RATELIMIT_STORAGE_URI=memory://

# --------------------------------------------------------------------
# Gunicorn (production only)
# --------------------------------------------------------------------

# Number of sync workers. Default 2 in entrypoint.prod.sh.
GUNICORN_WORKERS=2

# Per-request timeout in seconds. Default 120.
GUNICORN_TIMEOUT=120
