# Archivos y directorios de Python
__pycache__/
*.py[cod]
*.so
*.pyd

# Entornos virtuales
venv/
.env/
.venv/
env/

# Local environment files (secrets, DB credentials, per-machine config).
# The template `.env.example` is tracked and exempted below.
.env
.env.*
!.env.example

# Configuración de dependencias
pip-log.txt
pip-delete-this-directory.txt

# Archivos de configuración de editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos de logs y cachés
*.log
logs/

# Archivos de compilación y distribución
*.egg-info/
*.egg
*.manifest
*.spec

# Archivos de Docker
*.pid
*.tar
docker-compose.override.yml

# Configuración y credenciales
# (Local .env files are matched by the .env / .env.* rules at the top of this file.)

# Jupyter Notebooks
.ipynb_checkpoints/

# Marshmallow Schemas (si usas caching)
.mypy_cache/

# Local AI resources (per-developer, never commit content).
# Ignore all files inside, but keep the directory itself (and its .gitkeep) tracked.
.ai-resources/local/*
!.ai-resources/local/.gitkeep
!.ai-resources/local/.keep
!.ai-resources/local/README.md
